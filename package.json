{
  "name": "magpie-agent-vetta",
  "version": "0.0.0",
  "private": true,
  "description": "Magpie Agent integration for Vetta Desktop (under development)",
  "license": "MIT",
  "author": "wshiqyuan",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.23.0 <23 || >=24 <25",
    "pnpm": ">=10 <11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wshiqyuan/magpie-agent-vetta.git"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tools.json",
    "lint": "biome lint .",
    "format": "biome format --write . && prettier --write \"**/*.{md,yml,yaml}\"",
    "format:check": "biome format . && prettier --check \"**/*.{md,yml,yaml}\"",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check",
    "check:ci": "pnpm check && pnpm test:coverage && pnpm build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "pack:check": "pnpm build && pnpm pack --out artifacts/magpie-agent-vetta.tgz"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.1.1",
    "prettier": "3.10.1",
    "tsdown": "0.23.7",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
